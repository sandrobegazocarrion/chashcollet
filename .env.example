# Token del bot de Telegram (te lo da @BotFather al crear el bot)
TELEGRAM_BOT_TOKEN=

# Puerto del servidor (opcional, por defecto 4173 — en Railway/Render normalmente
# lo definen ellos automáticamente y no hace falta tocarlo)
PORT=4173

# Supabase (Configuración → API en tu proyecto de supabase.com)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origen(es) permitidos por CORS, separados por coma. Vacío = permitir cualquiera
# (cómodo en local; en producción poner la URL de Vercel del frontend).
ALLOWED_ORIGIN=

# Culqi (Fase 5 — pendiente de cuenta creada)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Cloudflare Turnstile (CAPTCHA en el registro). La Secret Key NO va acá — se
# configura directo en el panel de Supabase (Authentication → Bot and Abuse
# Protection), que es quien la usa para verificar el token con Cloudflare.
TURNSTILE_SITE_KEY=
